{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundboard",
  "version": "0.2.0",
  "identifier": "io.github.zainadosrepo.soundboard",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Soundboard",
        "width": 1180,
        "height": 720,
        "minWidth": 820,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "category": "Music",
    "shortDescription": "Sets de sons à jouer en direct",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["soundset"],
        "name": "Set Soundboard",
        "description": "Set de sons Soundboard",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["soundboard"]
      }
    }
  }
}
